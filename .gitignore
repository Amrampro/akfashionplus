# ======================================================
# DEPENDENCIES
# ======================================================

node_modules/
**/node_modules/


# ======================================================
# ENVIRONMENT VARIABLES
# ======================================================

# Par défaut, ignorer tous les fichiers .env
.env
.env.*

# Garder les fichiers d'exemple
!.env.example
!**/.env.example


# API : garder les secrets privés
api/.env
api/.env.*


# WEBAPP : autoriser le .env
# Il ne doit contenir que des variables publiques VITE_*
!webapp/.env


# MOBILEAPP : autoriser le .env
# Il ne doit contenir que des variables publiques EXPO_PUBLIC_*
!mobileapp/.env


# ======================================================
# PRODUCTION BUILDS
# ======================================================

dist/
build/
out/
dist-ssr/

**/dist/
**/build/
**/out/
**/dist-ssr/


# ======================================================
# VITE
# ======================================================

.vite/
**/.vite/
.vite-temp/


# ======================================================
# EXPO / REACT NATIVE
# ======================================================

.expo/
**/.expo/

.expo-shared/
**/.expo-shared/

web-build/


# ======================================================
# MOBILE SIGNING / CREDENTIALS
# ======================================================

*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision


# ======================================================
# EAS LOCAL BUILDS
# ======================================================

eas-build-local-nodejs/

*.apk
*.aab
*.ipa


# ======================================================
# API UPLOADS
# ======================================================

api/uploads/*
!api/uploads/.gitkeep

# Si tu veux conserver certains sous-dossiers :
#
# !api/uploads/products/
# api/uploads/products/*
# !api/uploads/products/.gitkeep


# ======================================================
# LOGS
# ======================================================

logs/
*.log

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*


# ======================================================
# TESTS / COVERAGE
# ======================================================

coverage/
**/coverage/


# ======================================================
# TEMPORARY FILES
# ======================================================

tmp/
temp/

*.tmp
*.temp


# ======================================================
# EDITORS / IDE
# ======================================================

.vscode/*
!.vscode/extensions.json

.idea/

*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.local


# ======================================================
# OPERATING SYSTEM FILES
# ======================================================

.DS_Store
Thumbs.db
Desktop.ini


# ======================================================
# PACKAGE MANAGER CACHE
# ======================================================

.npm/
.pnpm-store/

.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz


# ======================================================
# CLAUDE / LOCAL AI CONFIGURATION
